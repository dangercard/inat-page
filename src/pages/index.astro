---
import Base from "../layouts/Base.astro";
import { Image } from "astro:assets";
import inatLogo from "../assets/inaturalist-logo.png";
import Flask from "../components/Flask.astro";
import {
  establishment,
  fetchAllObservations,
  fetchAnnotationLabeler,
  photoUrl,
} from "../lib/inaturalist";
import type { Establishment, Observation } from "../lib/inaturalist";

const [observations, labelAnnotation] = await Promise.all([
  fetchAllObservations("alejandrodeloach"),
  fetchAnnotationLabeler(),
]);
const withPhotos = observations.filter((o) => o.photos.length > 0);

// Friendly names for iNaturalist's iconic taxa; anything unlisted is "Other".
const GROUP_LABELS: Record<string, string> = {
  Insecta: "Insects",
  Arachnida: "Arachnids",
  Mollusca: "Mollusks",
  Reptilia: "Reptiles",
  Amphibia: "Amphibians",
  Aves: "Birds",
  Mammalia: "Mammals",
  Actinopterygii: "Fish",
  Plantae: "Plants",
  Fungi: "Fungi",
};
const groupOf = (o: Observation) =>
  GROUP_LABELS[o.taxon?.iconic_taxon_name ?? ""] ?? "Other";

const STATUS_LABELS: Record<Establishment, string> = {
  endemic: "Endemic",
  native: "Native",
  introduced: "Introduced",
};

// Annotations worth showing. "Alive" and "Organism" are the default for
// nearly everything, so they'd only add noise.
function annotationsOf(o: Observation) {
  return (o.annotations ?? [])
    .map(labelAnnotation)
    .filter((a) => a !== null)
    .filter(
      (a) =>
        !(a.attribute === "Alive or Dead" && a.value === "Alive") &&
        !(a.attribute === "Evidence of Presence" && a.value === "Organism"),
    )
    .map((a) => a.value);
}

// "07:44" from the observer's local timestamp, shown as "7:44 AM".
function timeOf(o: Observation) {
  const m = o.time_observed_at?.match(/T(\d\d):(\d\d)/);
  if (!m) return null;
  const h = Number(m[1]);
  return `${h % 12 || 12}:${m[2]} ${h < 12 ? "AM" : "PM"}`;
}

const tabs = [
  {
    key: "wild",
    label: "Wild",
    obs: withPhotos.filter((o) => o.quality_grade !== "casual"),
  },
  {
    key: "casual",
    label: "Cultivated / Captive",
    obs: withPhotos.filter((o) => o.quality_grade === "casual"),
  },
] as const;

function buildPhotoList(list: Observation[]) {
  return list.flatMap((obs) => {
    const status = establishment(obs.taxon);
    const shared = {
      common:
        obs.taxon?.preferred_common_name ?? obs.species_guess ?? "Unknown",
      scientific: obs.taxon?.name ?? null,
      date: obs.observed_on,
      time: timeOf(obs),
      place: obs.place_guess,
      uri: obs.uri,
      researchGrade: obs.quality_grade === "research",
      status: status && STATUS_LABELS[status],
      annotations: annotationsOf(obs),
      wiki: obs.taxon?.wikipedia_url ?? null,
    };
    return obs.photos.map((photo, i) => ({
      ...shared,
      src: photoUrl(photo, "large"),
      thumb: photoUrl(photo, "medium"),
      attribution: photo.attribution,
      photoIndex: i + 1,
      photoCount: obs.photos.length,
    }));
  });
}

function buildCardStart(list: Observation[]) {
  let running = 0;
  return list.map((obs) => {
    const start = running;
    running += obs.photos.length;
    return start;
  });
}

const perTab = Object.fromEntries(
  tabs.map((t) => [t.key, buildPhotoList(t.obs)]),
);
const galleryPool = tabs.flatMap((t) => perTab[t.key]);
const photoLists = { ...perTab, gallery: galleryPool };
const cardStarts = Object.fromEntries(
  tabs.map((t) => [t.key, buildCardStart(t.obs)]),
);

// Catalog filter groups, most-observed first.
const groupCounts = new Map<string, number>();
for (const o of withPhotos) {
  groupCounts.set(groupOf(o), (groupCounts.get(groupOf(o)) ?? 0) + 1);
}
const groups = [...groupCounts.keys()].sort(
  (a, b) =>
    (a === "Other" ? 1 : 0) - (b === "Other" ? 1 : 0) ||
    groupCounts.get(b)! - groupCounts.get(a)!,
);

const SORTS = [
  { value: "newest", label: "Newest first" },
  { value: "oldest", label: "Oldest first" },
  { value: "name", label: "Name A–Z" },
  {
    value: "rarest",
    label: "Rarest on iNaturalist",
    hint: "Fewest observations site-wide",
  },
];

// ----- Stats strip -----
// Species-level taxa (subspecies roll up to their species).
const speciesIds = new Set<number>();
const endemicSpeciesIds = new Set<number>();
for (const o of observations) {
  const t = o.taxon;
  if (!t || (t.rank_level ?? 99) > 10) continue;
  const id = t.min_species_taxon_id ?? t.id;
  speciesIds.add(id);
  if (t.endemic) endemicSpeciesIds.add(id);
}
const firstYear = observations
  .map((o) => o.observed_on?.slice(0, 4))
  .filter(Boolean)
  .sort()[0];

const MONTHS = [
  "January", "February", "March", "April", "May", "June",
  "July", "August", "September", "October", "November", "December",
];
const monthCounts = MONTHS.map(() => 0);
for (const o of observations) {
  const m = Number(o.observed_on?.slice(5, 7));
  if (m) monthCounts[m - 1]++;
}
const monthMax = Math.max(1, ...monthCounts);
const peakMonth = monthCounts.indexOf(monthMax);

const stats = [
  { label: "Observations", value: observations.length.toLocaleString("en-US") },
  { label: "Species", value: speciesIds.size.toLocaleString("en-US") },
  { label: "Endemic species", value: endemicSpeciesIds.size.toLocaleString("en-US") },
  { label: "Observing since", value: firstYear ?? "—" },
];

// Initial mosaic tiles: a shuffled spread across the whole collection,
// each assigned a size so the grid reads as a varied mosaic.
const TILE_COUNT = Math.min(galleryPool.length, 30);

function shuffle<T>(arr: T[]): T[] {
  const a = [...arr];
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

const tileIndices = shuffle(galleryPool.map((_, i) => i)).slice(0, TILE_COUNT);

// Size bag: mostly small squares with a few larger feature tiles.
const bigN = Math.round(TILE_COUNT * 0.12);
const wideN = Math.round(TILE_COUNT * 0.16);
const tallN = Math.round(TILE_COUNT * 0.16);
const sizes = shuffle([
  ...Array(bigN).fill("big"),
  ...Array(wideN).fill("wide"),
  ...Array(tallN).fill("tall"),
  ...Array(Math.max(0, TILE_COUNT - bigN - wideN - tallN)).fill("small"),
]);

const mosaicTiles = tileIndices.map((idx, i) => ({
  idx,
  size: sizes[i] ?? "small",
}));
---

<Base title="El Yunque Wildlife">
  <section class="stats" aria-label="Collection at a glance">
    {
      stats.map((s) => (
        <div class="stat">
          <span class="stat-value">{s.value}</span>
          <span class="stat-label">{s.label}</span>
        </div>
      ))
    }
    <figure class="stat stat-months">
      <figcaption class="stat-label">Observations by month</figcaption>
      <div class="months" aria-hidden="true">
        {
          monthCounts.map((n, i) => (
            <div
              class:list={["month", { peak: i === peakMonth }]}
              data-tip={`${MONTHS[i]}: ${n} observation${n === 1 ? "" : "s"}`}
            >
              {i === peakMonth && <span class="month-value">{n}</span>}
              <span
                class="month-bar"
                style={`height: ${(n / monthMax) * 100}%`}
              />
              <span class="month-label">{MONTHS[i][0]}</span>
            </div>
          ))
        }
      </div>
      <table class="sr-only">
        <caption>Observations by month</caption>
        <tbody>
          {
            monthCounts.map((n, i) => (
              <tr>
                <th scope="row">{MONTHS[i]}</th>
                <td>{n}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </figure>
  </section>

  <div class="view-switch" role="tablist" aria-label="Choose view">
    <button
      class="view-btn active"
      data-view="gallery"
      role="tab"
      aria-selected="true"
    >
      Gallery
    </button>
    <button
      class="view-btn"
      data-view="catalog"
      role="tab"
      aria-selected="false"
    >
      Catalog
    </button>
  </div>

  <section id="view-gallery" class="view" data-view="gallery">
    <div class="mosaic">
      {
        mosaicTiles.map((tile) => {
          const p = galleryPool[tile.idx];
          return (
            <button
              class:list={["tile", tile.size]}
              data-pool-index={tile.idx}
              aria-label={p.common}
            >
              <img
                class="tile-img active"
                src={p.thumb}
                alt={p.common}
                loading="lazy"
              />
              <img class="tile-img" alt="" aria-hidden="true" />
            </button>
          );
        })
      }
    </div>
  </section>

  <section id="view-catalog" class="view" data-view="catalog" hidden>
    <div class="tabs" role="tablist">
      {
        tabs.map((t, idx) => (
          <button
            class={`tab ${idx === 0 ? "active" : ""}`}
            data-tab={t.key}
            role="tab"
            aria-selected={idx === 0 ? "true" : "false"}
          >
            {t.label} <span class="tab-count">{t.obs.length}</span>
          </button>
        ))
      }
    </div>

    <div class="filters">
      <div class="filter-row">
        <input
          type="search"
          class="filter-search"
          placeholder="Search by name"
          aria-label="Search by common or scientific name"
        />
        <div class="segmented" role="group" aria-label="Status in Puerto Rico">
          {
            ["all", "endemic", "native", "introduced"].map((s) => (
              <button
                class:list={["seg-btn", { active: s === "all" }]}
                data-status={s}
                aria-pressed={s === "all" ? "true" : "false"}
              >
                {s === "all" ? "Any status" : STATUS_LABELS[s as Establishment]}
              </button>
            ))
          }
        </div>
        <div class="filter-sort">
          {/* Touch screens tap this invisible native select (laid over the
              pill) to get the phone's own picker. */}
          <select class="filter-sort-native" aria-label="Sort by">
            {SORTS.map((s) => <option value={s.value}>{s.label}</option>)}
          </select>
          <button
            class="filter-sort-btn"
            aria-haspopup="listbox"
            aria-expanded="false"
            aria-labelledby="sort-label sort-value"
          >
            <span id="sort-label" class="filter-sort-label">Sort by</span>
            <span id="sort-value" class="filter-sort-value"
              >{SORTS[0].label}</span
            >
            <svg
              class="filter-sort-chevron"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M6 9l6 6 6-6" />
            </svg>
          </button>
          <ul
            class="sort-menu"
            role="listbox"
            aria-labelledby="sort-label"
            tabindex="-1"
            hidden
          >
            {
              SORTS.map((s, i) => (
                <li
                  id={`sort-${s.value}`}
                  class="sort-option"
                  role="option"
                  data-value={s.value}
                  aria-selected={i === 0 ? "true" : "false"}
                >
                  <svg
                    class="sort-check"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M5 12.5l4.5 4.5L19 7.5" />
                  </svg>
                  <span class="sort-text">
                    <span class="sort-name">{s.label}</span>
                    {s.hint && <span class="sort-hint">{s.hint}</span>}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <div class="chips" role="group" aria-label="Group">
        <button class="chip active" data-group="all" aria-pressed="true">
          All <span class="chip-count"></span>
        </button>
        {
          groups.map((g) => (
            <button class="chip" data-group={g} aria-pressed="false">
              {g} <span class="chip-count" />
            </button>
          ))
        }
      </div>
      <p class="filter-summary" aria-live="polite"></p>
    </div>

    {
      tabs.map((t, idx) => (
        <ul class="grid" data-tab={t.key} hidden={idx !== 0}>
          {t.obs.map((obs, i) => {
            const photo = obs.photos[0];
            const common =
              obs.taxon?.preferred_common_name ??
              obs.species_guess ??
              "Unknown";
            const scientific = obs.taxon?.name;
            return (
              <li
                class="card"
                data-order={i}
                data-group={groupOf(obs)}
                data-status={establishment(obs.taxon) ?? ""}
                data-name={`${common} ${scientific ?? ""}`.toLowerCase()}
                data-sort-name={common.toLowerCase()}
                data-rarity={obs.taxon?.observations_count ?? ""}
                data-start={cardStarts[t.key][i]}
                data-count={obs.photos.length}
              >
                <a
                  href={obs.uri}
                  target="_blank"
                  rel="noopener"
                >
                  <div class="thumb">
                    <img
                      src={photoUrl(photo, "medium")}
                      alt={common}
                      loading="lazy"
                      width={photo.original_dimensions?.width ?? 500}
                      height={photo.original_dimensions?.height ?? 500}
                    />
                    {obs.quality_grade === "research" && (
                      <span class="badge badge-rg" title="Research grade">
                        <Flask class="rg-icon" />
                        <span class="sr-only">Research grade</span>
                      </span>
                    )}
                    {obs.photos.length > 1 && (
                      <span class="badge">+{obs.photos.length - 1}</span>
                    )}
                  </div>
                  <div class="caption">
                    <span class="common">{common}</span>
                    {scientific && <span class="sci">{scientific}</span>}
                    {obs.observed_on && <time>{obs.observed_on}</time>}
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      ))
    }
    <div class="filter-empty" hidden>
      <p>No observations match these filters.</p>
      <button class="chip" data-clear-filters>Clear filters</button>
    </div>
  </section>

  <div
    id="lightbox"
    class="lightbox"
    aria-modal="true"
    role="dialog"
    aria-label="Observation viewer"
  >
    <button class="lb-close" id="lightbox-close" aria-label="Close"
      >&times;</button
    >
    <button class="lb-nav lb-prev" id="lightbox-prev" aria-label="Previous">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M19 12H5" />
        <path d="M12 19l-7-7 7-7" />
      </svg>
    </button>
    <button class="lb-nav lb-next" id="lightbox-next" aria-label="Next">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M5 12h14" />
        <path d="M12 5l7 7-7 7" />
      </svg>
    </button>
    <figure class="lb-figure" onclick="event.stopPropagation()">
      <div class="lb-img-wrap" id="lightbox-img-wrap">
        <img id="lightbox-img" alt="" />
      </div>
      <figcaption class="lb-caption">
        <div class="lb-title">
          <span id="lightbox-common" class="lb-common"></span>
          <span id="lightbox-sci" class="lb-sci"></span>
          <span id="lightbox-rg" class="lb-rg" hidden>
            <Flask class="rg-icon" /> Research Grade
          </span>
          <span id="lightbox-status" class="lb-status" hidden></span>
          <span class="lb-title-right">
            <span id="lightbox-counter" class="lb-counter" hidden></span>
            <a
              id="lightbox-link"
              class="lb-inat-link"
              href="#"
              target="_blank"
              rel="noopener"
            >
              <Image
                src={inatLogo}
                alt="View on iNaturalist"
                width={56}
                class="lb-inat-logo"
              />
            </a>
          </span>
        </div>
        <div id="lightbox-meta" class="lb-meta"></div>
        <div id="lightbox-tags" class="lb-tags" hidden></div>
        <div class="lb-footer">
          <span id="lightbox-attr" class="lb-attr"></span>
          <a
            id="lightbox-wiki"
            class="lb-wiki"
            href="#"
            target="_blank"
            rel="noopener"
            hidden>Read about this species on Wikipedia</a
          >
        </div>
      </figcaption>
    </figure>
  </div>
</Base>

<script is:inline define:vars={{ photoLists }}>
  (() => {
    const lightbox = document.getElementById("lightbox");
    const img = document.getElementById("lightbox-img");
    const imgWrap = document.getElementById("lightbox-img-wrap");
    const common = document.getElementById("lightbox-common");
    const sci = document.getElementById("lightbox-sci");
    const rg = document.getElementById("lightbox-rg");
    const counter = document.getElementById("lightbox-counter");
    const meta = document.getElementById("lightbox-meta");
    const attr = document.getElementById("lightbox-attr");
    const link = document.getElementById("lightbox-link");
    const closeBtn = document.getElementById("lightbox-close");
    const prevBtn = document.getElementById("lightbox-prev");
    const nextBtn = document.getElementById("lightbox-next");
    const statusEl = document.getElementById("lightbox-status");
    const tags = document.getElementById("lightbox-tags");
    const wiki = document.getElementById("lightbox-wiki");

    let active = null; // current photo list
    let index = 0;
    const preloadCache = new Map(); // keyed by src

    function wrap(i, len) {
      return ((i % len) + len) % len;
    }

    function preload(i) {
      if (!active) return;
      const src = active[wrap(i, active.length)].src;
      if (preloadCache.has(src)) return;
      const im = new Image();
      im.src = src;
      preloadCache.set(src, im);
    }

    // `list` is the photo sequence prev/next step through.
    function show(list, i) {
      active = list;
      if (!active || active.length === 0) return;
      index = wrap(i, active.length);
      const p = active[index];
      img.src = p.src;
      img.alt = p.common;
      preload(index + 1);
      preload(index + 2);
      preload(index - 1);
      common.textContent = p.common;
      sci.textContent = p.scientific ?? "";
      rg.hidden = !p.researchGrade;
      if (p.photoCount > 1) {
        counter.textContent = `${p.photoIndex} / ${p.photoCount}`;
        counter.hidden = false;
      } else {
        counter.hidden = true;
      }
      statusEl.textContent = p.status ?? "";
      statusEl.hidden = !p.status;
      statusEl.dataset.status = (p.status ?? "").toLowerCase();
      const parts = [];
      if (p.date) parts.push(p.date);
      if (p.time) parts.push(p.time);
      if (p.place) parts.push(p.place);
      meta.textContent = parts.join(" · ");
      tags.replaceChildren(
        ...p.annotations.map((a) => {
          const el = document.createElement("span");
          el.className = "lb-tag";
          el.textContent = a;
          return el;
        }),
      );
      tags.hidden = p.annotations.length === 0;
      attr.textContent = p.attribution ?? "";
      link.href = p.uri;
      wiki.hidden = !p.wiki;
      if (p.wiki) wiki.href = p.wiki;
      resetZoom();
      lightbox.classList.add("open");
      document.body.style.overflow = "hidden";
    }

    function resetZoom() {
      img.classList.remove("zoomed");
      img.style.transformOrigin = "";
    }

    function originFromEvent(e) {
      const rect = imgWrap.getBoundingClientRect();
      const x = ((e.clientX - rect.left) / rect.width) * 100;
      const y = ((e.clientY - rect.top) / rect.height) * 100;
      return `${x}% ${y}%`;
    }

    // Touch screens use the browser's own pinch-zoom instead of tap-to-zoom.
    const coarsePointer = window.matchMedia(
      "(hover: none) and (pointer: coarse)",
    ).matches;

    imgWrap.addEventListener("click", (e) => {
      e.stopPropagation();
      if (coarsePointer) return;
      if (img.classList.contains("zoomed")) {
        resetZoom();
      } else {
        img.style.transformOrigin = originFromEvent(e);
        img.classList.add("zoomed");
      }
    });

    imgWrap.addEventListener("mousemove", (e) => {
      if (!img.classList.contains("zoomed")) return;
      img.style.transformOrigin = originFromEvent(e);
    });

    function close() {
      lightbox.classList.remove("open");
      document.body.style.overflow = "";
      resetZoom();
      img.src = "";
    }

    // Catalog cards open the lightbox over just the cards currently visible
    // (after filtering and sorting), in on-screen order.
    document.querySelectorAll(".card").forEach((card) => {
      card.querySelector("a").addEventListener("click", (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        e.preventDefault();
        const grid = card.closest(".grid");
        const photos = photoLists[grid.dataset.tab];
        const list = [];
        let start = 0;
        for (const c of grid.querySelectorAll(".card:not([hidden])")) {
          if (c === card) start = list.length;
          const s = Number(c.dataset.start);
          list.push(...photos.slice(s, s + Number(c.dataset.count)));
        }
        show(list, start);
      });
    });

    prevBtn.addEventListener("click", () => show(active, index - 1));
    nextBtn.addEventListener("click", () => show(active, index + 1));
    closeBtn.addEventListener("click", close);
    lightbox.addEventListener("click", (e) => {
      if (e.target === lightbox) close();
    });

    document.addEventListener("keydown", (e) => {
      if (!lightbox.classList.contains("open")) return;
      if (e.key === "Escape") close();
      else if (e.key === "ArrowLeft") show(active, index - 1);
      else if (e.key === "ArrowRight") show(active, index + 1);
    });

    // ----- Lightbox: swipe between photos on touch screens -----
    // The photo follows the finger; past the threshold it advances, and the
    // next photo slides in from the side the swipe came from.
    const SWIPE_THRESHOLD = 50;
    const swipeMotion = !window.matchMedia("(prefers-reduced-motion: reduce)")
      .matches;
    let swipe = null;

    function resetSwipe() {
      imgWrap.style.transition = "";
      imgWrap.style.transform = "";
      imgWrap.style.opacity = "";
    }

    lightbox.addEventListener(
      "touchstart",
      (e) => {
        // Leave pinch gestures alone, and don't swipe while pinch-zoomed in
        // (a one-finger drag then pans around the photo).
        const pinchZoomed = (window.visualViewport?.scale ?? 1) > 1.01;
        if (
          e.touches.length !== 1 ||
          pinchZoomed ||
          img.classList.contains("zoomed")
        ) {
          swipe = null;
          return;
        }
        const t = e.touches[0];
        swipe = { x: t.clientX, y: t.clientY, dx: 0, horizontal: null };
      },
      { passive: true },
    );

    lightbox.addEventListener(
      "touchmove",
      (e) => {
        if (!swipe || e.touches.length !== 1) return;
        const t = e.touches[0];
        const dx = t.clientX - swipe.x;
        const dy = t.clientY - swipe.y;
        // Decide once whether this gesture is a horizontal swipe.
        if (swipe.horizontal === null && Math.hypot(dx, dy) > 10) {
          swipe.horizontal = Math.abs(dx) > Math.abs(dy);
        }
        if (!swipe.horizontal) return;
        swipe.dx = dx;
        if (swipeMotion) {
          imgWrap.style.transition = "none";
          imgWrap.style.transform = `translateX(${dx}px)`;
          imgWrap.style.opacity = String(1 - Math.min(Math.abs(dx) / 500, 0.4));
        }
      },
      { passive: true },
    );

    lightbox.addEventListener("touchend", () => {
      if (!swipe) return;
      const { dx, horizontal } = swipe;
      swipe = null;
      resetSwipe();
      if (!horizontal || Math.abs(dx) < SWIPE_THRESHOLD) return;
      const step = dx < 0 ? 1 : -1;
      show(active, index + step);
      if (swipeMotion) {
        imgWrap.animate(
          [
            { transform: `translateX(${step * 60}px)`, opacity: 0 },
            { transform: "translateX(0)", opacity: 1 },
          ],
          { duration: 220, easing: "ease-out" },
        );
      }
    });

    lightbox.addEventListener("touchcancel", () => {
      swipe = null;
      resetSwipe();
    });

    // ----- Catalog: tabs, filters, sorting -----
    const grids = [...document.querySelectorAll(".grid[data-tab]")];
    const tabBtns = [...document.querySelectorAll(".tab")];
    const searchInput = document.querySelector(".filter-search");
    const statusBtns = [...document.querySelectorAll(".seg-btn")];
    const chips = [...document.querySelectorAll(".chip[data-group]")];
    const summary = document.querySelector(".filter-summary");
    const empty = document.querySelector(".filter-empty");

    const filters = {
      tab: "wild",
      query: "",
      status: "all",
      group: "all",
      sort: "newest",
    };

    function matches(card, ignoreGroup = false) {
      const d = card.dataset;
      if (filters.query && !d.name.includes(filters.query)) return false;
      if (filters.status !== "all" && d.status !== filters.status) return false;
      if (!ignoreGroup && filters.group !== "all" && d.group !== filters.group)
        return false;
      return true;
    }

    const sorters = {
      newest: (a, b) => a.dataset.order - b.dataset.order,
      oldest: (a, b) => b.dataset.order - a.dataset.order,
      name: (a, b) => a.dataset.sortName.localeCompare(b.dataset.sortName),
      // Unknown rarity sorts last.
      rarest: (a, b) =>
        (Number(a.dataset.rarity) || Infinity) -
        (Number(b.dataset.rarity) || Infinity),
    };

    function applyFilters() {
      const grid = grids.find((g) => g.dataset.tab === filters.tab);
      grids.forEach((g) => (g.hidden = g !== grid));

      let shown = 0;
      grids.forEach((g) => {
        const cards = [...g.children];
        let n = 0;
        cards.forEach((c) => {
          c.hidden = !matches(c);
          if (!c.hidden) n++;
        });
        if (g === grid) {
          shown = n;
          cards.sort(sorters[filters.sort]).forEach((c) => g.append(c));
        }
        // Tab counts follow the filters so you can see matches in both tabs.
        const tab = tabBtns.find((t) => t.dataset.tab === g.dataset.tab);
        tab.querySelector(".tab-count").textContent = n;
      });

      // Group chip counts ignore the group filter itself, so each chip says
      // how many you'd see if you picked it.
      const counts = { all: 0 };
      for (const c of grid.children) {
        if (!matches(c, true)) continue;
        counts.all++;
        counts[c.dataset.group] = (counts[c.dataset.group] ?? 0) + 1;
      }
      chips.forEach((chip) => {
        const n = counts[chip.dataset.group] ?? 0;
        chip.querySelector(".chip-count").textContent = n;
        chip.classList.toggle("empty", n === 0);
      });

      const total = grid.children.length;
      summary.textContent =
        shown === total ? `${total} observations` : `Showing ${shown} of ${total}`;
      empty.hidden = shown > 0;
    }

    function setPressed(buttons, pressed) {
      buttons.forEach((b) => {
        const on = b === pressed;
        b.classList.toggle("active", on);
        b.setAttribute(b.getAttribute("role") === "tab" ? "aria-selected" : "aria-pressed", on);
      });
    }

    tabBtns.forEach((tab) =>
      tab.addEventListener("click", () => {
        filters.tab = tab.dataset.tab;
        setPressed(tabBtns, tab);
        applyFilters();
      }),
    );
    statusBtns.forEach((btn) =>
      btn.addEventListener("click", () => {
        filters.status = btn.dataset.status;
        setPressed(statusBtns, btn);
        applyFilters();
      }),
    );
    chips.forEach((chip) =>
      chip.addEventListener("click", () => {
        filters.group = chip.dataset.group;
        setPressed(chips, chip);
        applyFilters();
      }),
    );
    searchInput.addEventListener("input", () => {
      filters.query = searchInput.value.trim().toLowerCase();
      applyFilters();
    });

    // Sort menu: a button plus a listbox, so the open menu can be styled.
    // Keyboard: arrows/Home/End move, Enter/Space pick, Escape/Tab close.
    const sortBtn = document.querySelector(".filter-sort-btn");
    const sortValue = document.querySelector(".filter-sort-value");
    const sortMenu = document.querySelector(".sort-menu");
    const sortOptions = [...sortMenu.querySelectorAll(".sort-option")];
    let sortActive = 0;

    function setSortActive(i) {
      sortActive = (i + sortOptions.length) % sortOptions.length;
      sortOptions.forEach((o, j) =>
        o.classList.toggle("active", j === sortActive),
      );
      sortMenu.setAttribute(
        "aria-activedescendant",
        sortOptions[sortActive].id,
      );
    }

    function openSortMenu() {
      sortMenu.hidden = false;
      sortBtn.setAttribute("aria-expanded", "true");
      setSortActive(
        sortOptions.findIndex((o) => o.dataset.value === filters.sort),
      );
      sortMenu.focus();
    }

    function closeSortMenu(returnFocus = true) {
      if (sortMenu.hidden) return;
      sortMenu.hidden = true;
      sortBtn.setAttribute("aria-expanded", "false");
      if (returnFocus) sortBtn.focus();
    }

    // Keeps the pill label, the custom menu and the native select in sync.
    function setSort(value) {
      filters.sort = value;
      sortOptions.forEach((o) =>
        o.setAttribute(
          "aria-selected",
          o.dataset.value === value ? "true" : "false",
        ),
      );
      const option = sortOptions.find((o) => o.dataset.value === value);
      sortValue.textContent = option.querySelector(".sort-name").textContent;
      sortNative.value = value;
      applyFilters();
    }

    function pickSort(option) {
      closeSortMenu();
      setSort(option.dataset.value);
    }

    // On touch screens the native select takes over; keep the visual pill
    // out of the tab order and away from screen readers there.
    const sortNative = document.querySelector(".filter-sort-native");
    sortNative.addEventListener("change", () => setSort(sortNative.value));
    if (coarsePointer) {
      sortBtn.tabIndex = -1;
      sortBtn.setAttribute("aria-hidden", "true");
    }

    sortBtn.addEventListener("click", () =>
      sortMenu.hidden ? openSortMenu() : closeSortMenu(),
    );
    sortBtn.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown" || e.key === "ArrowUp") {
        e.preventDefault();
        openSortMenu();
      }
    });
    sortOptions.forEach((o, i) => {
      o.addEventListener("click", () => pickSort(o));
      o.addEventListener("mousemove", () => setSortActive(i));
    });
    sortMenu.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown") setSortActive(sortActive + 1);
      else if (e.key === "ArrowUp") setSortActive(sortActive - 1);
      else if (e.key === "Home") setSortActive(0);
      else if (e.key === "End") setSortActive(sortOptions.length - 1);
      else if (e.key === "Enter" || e.key === " ")
        pickSort(sortOptions[sortActive]);
      else if (e.key === "Escape") closeSortMenu();
      else if (e.key === "Tab") return closeSortMenu(false);
      else return;
      e.preventDefault();
    });
    document.addEventListener("click", (e) => {
      if (!e.target.closest(".filter-sort")) closeSortMenu(false);
    });
    document
      .querySelector("[data-clear-filters]")
      .addEventListener("click", () => {
        searchInput.value = "";
        Object.assign(filters, { query: "", status: "all", group: "all" });
        setPressed(statusBtns, statusBtns[0]);
        setPressed(chips, chips[0]);
        applyFilters();
      });

    applyFilters();

    // ----- Gallery: cycling image mosaic -----
    const pool = photoLists.gallery || [];
    const tileEls = [...document.querySelectorAll(".tile")];
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const displayed = new Set(
      tileEls.map((t) => parseInt(t.dataset.poolIndex, 10)),
    );

    tileEls.forEach((tile) => {
      tile.addEventListener("click", () => {
        show(pool, parseInt(tile.dataset.poolIndex, 10));
      });
    });

    function cycleOne() {
      if (pool.length <= tileEls.length) return; // nothing new to rotate in
      const tile = tileEls[Math.floor(Math.random() * tileEls.length)];
      let newIdx;
      let tries = 0;
      do {
        newIdx = Math.floor(Math.random() * pool.length);
      } while (displayed.has(newIdx) && ++tries < 40);
      if (displayed.has(newIdx)) return;

      const oldIdx = parseInt(tile.dataset.poolIndex, 10);
      const layers = tile.querySelectorAll(".tile-img");
      const activeLayer = tile.querySelector(".tile-img.active") || layers[0];
      const hiddenLayer = activeLayer === layers[0] ? layers[1] : layers[0];
      const p = pool[newIdx];

      const pre = new Image();
      pre.onload = () => {
        hiddenLayer.src = p.thumb;
        hiddenLayer.alt = p.common;
        hiddenLayer.classList.add("active");
        activeLayer.classList.remove("active");
        activeLayer.alt = "";
        displayed.delete(oldIdx);
        displayed.add(newIdx);
        tile.dataset.poolIndex = String(newIdx);
        tile.setAttribute("aria-label", p.common);
      };
      pre.src = p.thumb;
    }

    let cycleTimer = null;
    function startCycling() {
      if (reduceMotion || cycleTimer || pool.length <= tileEls.length) return;
      cycleTimer = setInterval(() => {
        if (!document.hidden) cycleOne();
      }, 2000);
    }
    function stopCycling() {
      if (cycleTimer) {
        clearInterval(cycleTimer);
        cycleTimer = null;
      }
    }

    // ----- View switch (Gallery / Catalog) -----
    const viewBtns = [...document.querySelectorAll(".view-btn")];
    const views = [...document.querySelectorAll(".view")];
    function setView(name) {
      viewBtns.forEach((b) => {
        const on = b.dataset.view === name;
        b.classList.toggle("active", on);
        b.setAttribute("aria-selected", on ? "true" : "false");
      });
      views.forEach((v) => {
        v.hidden = v.dataset.view !== name;
      });
      if (name === "gallery") startCycling();
      else stopCycling();
    }
    viewBtns.forEach((b) => {
      b.addEventListener("click", () => setView(b.dataset.view));
    });

    startCycling();
  })();
</script>

