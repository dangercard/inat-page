---
import { Image } from "astro:assets";
import inatLogo from "../assets/inaturalist-logo.png";

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <h1>El Yunque Wildlife</h1>
      <p>
        <a
          class="inat-link"
          data-tooltip="View on iNaturalist"
          href="https://www.inaturalist.org/observations?place_id=any&user_id=alejandrodeloach&verifiable=any"
          target="_blank"
          rel="noopener"
        >
          <Image
            src={inatLogo}
            alt="View on iNaturalist"
            width={72}
            class="inat-logo"
          />
        </a>
      </p>
      <p>
        Hobbyist wildlife photographer sharing the species diversity of my
        hometown. This page is not affiliated with the National Park Service.
      </p>
    </header>
    <main>
      <slot />
    </main>
    <style is:global>
      :root {
        color-scheme: dark;
        /* Forest palette: 040c06 112318 1e3a29 305d42 4d8061 89a257 bedc7f eeffcc */
        --bg: #040c06;
        --fg: #eeffcc;
        --muted: #89a257;
        --accent: #bedc7f;
        --card: #112318;
        --thumb: #1e3a29;
        --border: rgba(190, 220, 127, 0.14);
        --chip: rgba(137, 162, 87, 0.15);
        /* Dark ink used for text sitting on top of --accent fills. */
        --on-accent: #040c06;
      }
      * {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        padding: 0;
      }
      html {
        scrollbar-width: none;
        -ms-overflow-style: none;
      }
      html::-webkit-scrollbar {
        display: none;
      }
      body {
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
        background: var(--bg);
        color: var(--fg);
        line-height: 1.5;
        min-height: 100vh;
      }
      header {
        padding: 2rem 1.5rem 1rem;
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }
      header h1 {
        margin: 0;
        font-size: 2rem;
        font-weight: 600;
      }
      header p {
        margin: 0;
        color: var(--muted);
        font-size: 0.9rem;
      }
      header a {
        color: var(--accent);
        text-decoration: none;
      }
      header a:hover {
        text-decoration: underline;
      }

      @media screen and (max-width: 636px) {
        header {
          display: block;
          text-align: left;
          background: none;
        }
      }
      .inat-link {
        position: relative;
        display: inline-flex;
        align-items: center;
      }
      .inat-link::after {
        content: attr(data-tooltip);
        position: absolute;
        top: calc(100% + 0.5rem);
        left: 50%;
        transform: translateX(-50%) translateY(-0.25rem);
        background: var(--card);
        color: var(--fg);
        border: 1px solid var(--border);
        padding: 0.3rem 0.6rem;
        border-radius: 6px;
        font-size: 0.8rem;
        line-height: 1;
        white-space: nowrap;
        opacity: 0;
        pointer-events: none;
        transition:
          opacity 0.15s ease,
          transform 0.15s ease;
        z-index: 10;
      }
      .inat-link:hover::after,
      .inat-link:focus-visible::after {
        opacity: 1;
        transform: translateX(-50%) translateY(0);
      }
      .inat-link:hover {
        text-decoration: none;
      }
      .inat-logo {
        height: 1.9rem;
        width: auto;
        display: block;
        transition: transform 0.15s ease;
      }
      .inat-link:hover .inat-logo {
        transform: scale(1.06);
      }
      main {
        max-width: 1200px;
        margin: 0 auto;
        padding: 1rem 1.5rem 4rem;
      }
    </style>
  </body>
</html>
